---
import { dilBul, ceviri, digerDilYolu } from '../i18n/ui';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const dil  = dilBul(Astro.url.pathname);
const t    = ceviri(dil);

const kok = dil === 'tr' ? `${base}/` : `${base}/en/`;

const navLinks = dil === 'tr'
  ? [
      { href: `${base}/eserler`,  label: t('nav.eserler') },
      { href: `${base}/sergiler`, label: t('nav.sergiler') },
      { href: `${base}/hakkinda`, label: t('nav.hakkinda') },
      { href: `${base}/iletisim`, label: t('nav.iletisim') },
    ]
  : [
      { href: `${base}/en/works`,       label: t('nav.eserler') },
      { href: `${base}/en/exhibitions`, label: t('nav.sergiler') },
      { href: `${base}/en/about`,       label: t('nav.hakkinda') },
      { href: `${base}/en/contact`,     label: t('nav.iletisim') },
    ];

const currentPath = Astro.url.pathname;

// Dil değiştirici: aynı sayfanın diğer dildeki karşılığına gider
const digerDil     = dil === 'tr' ? 'en' : 'tr';
const digerDilLink = base + digerDilYolu(currentPath, digerDil);
const digerDilEtiket = digerDil === 'en' ? 'EN' : 'TR';

/**
 * Menü yalnızca ana sayfada, tam ekran hero görselinin üzerinde saydam durur.
 * Diğer sayfaların arka planı krem olduğu için saydam menü görünmez olur
 * (krem yazı krem zemin üzerinde kalır). Bu yüzden orada baştan opak başlar.
 */
const temiz    = currentPath.replace(/\/$/, '');
const heroVar  = temiz === '' || temiz === base || temiz === `${base}/en`;

// Hero'suz sayfalarda JS hiç çalışmaz; renkler doğrudan burada verilir.
// Hero'lu sayfada başlangıç rengi krem, kaydırınca JS koyuya çevirir.
const logoRenk = heroVar ? 'text-cream' : 'text-ink';
const linkRenk = heroVar ? 'text-cream/80' : 'text-muted';
const ikonRenk = heroVar ? 'text-cream' : 'text-ink';
const dilRenk  = heroVar ? 'text-cream/80 border-cream/40' : 'text-muted border-warm/40';
---

<header
  id="site-nav"
  data-hero={heroVar ? 'true' : 'false'}
  class={`fixed top-0 left-0 right-0 z-50 transition-all duration-300 border-b ${
    heroVar ? 'border-transparent' : 'bg-cream/95 backdrop-blur-sm border-warm/10'
  }`}
>
  {/* Hero'nun üst şeridi açık renkli olabiliyor; menü yazısının okunması için
      yukarıdan aşağı sönümlenen ince bir karartma. Ana sayfada, sayfa
      başındayken görünür. */}
  {heroVar && (
    <div
      id="nav-perde"
      class="absolute inset-x-0 top-0 h-28 -z-10 pointer-events-none bg-gradient-to-b from-ink/70 via-ink/38 to-transparent transition-opacity duration-300"
    ></div>
  )}

  <nav class="max-w-7xl mx-auto px-6 py-4 flex items-center justify-between">
    <a href={kok} class={`font-serif text-xl tracking-wide transition-colors nav-logo ${logoRenk}`}>
      İlknur Gürcan
    </a>
    {/* Logo ana sayfaya döner. Tıklanabilir olduğu belli olsun diye
        global.css'te hover durumu tanımlı. */}

    <!-- Desktop menu -->
    <ul class="hidden md:flex items-center gap-8">
      {navLinks.map(link => (
        <li>
          <a
            href={link.href}
            class={`nav-link text-sm font-[400] tracking-widest uppercase transition-colors ${
              currentPath.startsWith(link.href) ? 'text-gold' : linkRenk
            }`}
          >
            {link.label}
          </a>
        </li>
      ))}
      <li>
        <a
          href={digerDilLink}
          class={`nav-dil text-xs font-[500] tracking-widest border px-2.5 py-1 transition-colors ${dilRenk}`}
          aria-label={digerDil === 'en' ? 'Switch to English' : 'Türkçeye geç'}
        >
          {digerDilEtiket}
        </a>
      </li>
    </ul>

    <!-- Mobil: dil düğmesi + hamburger.
         Dil düğmesi menünün içinde değil dışında; ona en çok ihtiyacı olan
         kişi Türkçe okuyamayan kişi ve "Menü" yazan bir düğmeyi açması
         beklenmemeli. -->
    <div class="flex items-center gap-3 md:hidden">
      <a
        href={digerDilLink}
        class={`nav-dil text-xs font-[500] tracking-widest border px-2.5 py-1 transition-colors ${dilRenk}`}
        aria-label={digerDil === 'en' ? 'Switch to English' : 'Türkçeye geç'}
      >
        {digerDilEtiket}
      </a>
      <button id="mobile-menu-btn" class={`nav-icon ${ikonRenk}`} aria-label={dil === 'tr' ? 'Menü' : 'Menu'}>
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 6h16M4 12h16M4 18h16"/>
        </svg>
      </button>
    </div>
  </nav>

  <!-- Mobile menu -->
  <div id="mobile-menu" class="hidden md:hidden bg-cream/95 backdrop-blur-sm border-t border-warm/10">
    <ul class="px-6 py-4 flex flex-col gap-4">
      {/* Mobilde logonun tıklanabilirliği belli olmuyor (hover yok),
          bu yüzden ana sayfa burada da açıkça yer alıyor. */}
      <li>
        <a
          href={kok}
          class={`text-sm tracking-widest uppercase transition-colors ${
            heroVar ? 'text-gold' : 'text-muted hover:text-ink'
          }`}
        >
          {t('nav.anasayfa')}
        </a>
      </li>
      {navLinks.map(link => (
        <li>
          <a
            href={link.href}
            class="text-sm tracking-widest uppercase text-muted hover:text-ink transition-colors"
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  btn?.addEventListener('click', () => menu?.classList.toggle('hidden'));

  const nav = document.getElementById('site-nav');

  // Menü yalnızca ana sayfada saydam başlar. Diğer sayfalarda arka plan krem
  // olduğu için saydam menü görünmez olurdu; oraya sunucu tarafında zaten opak
  // stil basılıyor ve burada hiçbir şey yapmıyoruz.
  if (nav?.dataset.hero === 'true') {
    const perde  = document.getElementById('nav-perde');
    const logo   = document.querySelector('.nav-logo') as HTMLElement | null;
    const links  = document.querySelectorAll<HTMLElement>('.nav-link:not(.text-gold)');
    const icon   = document.querySelector('.nav-icon') as HTMLElement | null;
    // Masaüstü ve mobil için iki ayrı dil düğmesi var; ikisi de güncellenmeli
    const dilBtnler = document.querySelectorAll<HTMLElement>('.nav-dil');

    let sonDurum: boolean | null = null;

    function guncelle() {
      const kaydirildi = window.scrollY > 60;
      if (kaydirildi === sonDurum) return;      // gereksiz sınıf işlemi yapma
      sonDurum = kaydirildi;

      nav!.classList.toggle('bg-cream/95', kaydirildi);
      nav!.classList.toggle('backdrop-blur-sm', kaydirildi);
      nav!.classList.toggle('border-warm/10', kaydirildi);
      nav!.classList.toggle('border-transparent', !kaydirildi);

      // Karartma perdesi yalnızca menü saydamken gerekli
      perde?.classList.toggle('opacity-0', kaydirildi);

      logo?.classList.toggle('text-ink', kaydirildi);
      logo?.classList.toggle('text-cream', !kaydirildi);

      links.forEach(l => {
        l.classList.toggle('text-muted', kaydirildi);
        l.classList.toggle('text-cream/80', !kaydirildi);
      });

      icon?.classList.toggle('text-ink', kaydirildi);
      icon?.classList.toggle('text-cream', !kaydirildi);

      dilBtnler.forEach(d => {
        d.classList.toggle('text-muted', kaydirildi);
        d.classList.toggle('border-warm/40', kaydirildi);
        d.classList.toggle('text-cream/80', !kaydirildi);
        d.classList.toggle('border-cream/40', !kaydirildi);
      });
    }

    guncelle();
    window.addEventListener('scroll', guncelle, { passive: true });
  }
</script>
