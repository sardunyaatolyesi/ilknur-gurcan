---
/**
 * Atölyenin schema.org künyesi (JSON-LD) — iletişim sayfalarında kullanılır.
 *
 * Ne işe yarar: Google'ın "Çayyolu resim atölyesi" gibi yerel aramalarda
 * burayı bir işletme olarak tanıyabilmesi için adresi, iletişim bilgilerini
 * ve sanatçıyı makine okunur biçimde bildirir. Ziyaretçi bunu görmez.
 *
 * Tür neden iki tane: burası bazen eserlerin sergilenip satıldığı bir galeri,
 * bazen resim kursu verilen bir atölye olarak çalışıyor. JSON-LD birden fazla
 * tür bildirmeye izin verir; ikisini birden yazmak gerçek duruma daha yakın.
 */
interface Props {
  dil: 'tr' | 'en';
}

const { dil } = Astro.props;
const SITE = 'https://ilknurgurcan.com';

// Konum ve harita bağlantısı, atölyenin Google İşletme kaydından alındı.
// cid=... biçimi kaydın kalıcı kimliğidir; uzun paylaşım bağlantılarındaki
// takip parametrelerini içermez ve zamanla bozulmaz.
const ENLEM  = 39.8907104;
const BOYLAM = 32.6812903;
const haritaLinki = 'https://www.google.com/maps?cid=8140269433359174058';

const sanatci = {
  '@type': 'Person',
  '@id': `${SITE}/#ilknur-gurcan`,
  name: 'İlknur Gürcan',
  jobTitle: dil === 'tr' ? 'Ressam' : 'Painter',
  url: dil === 'tr' ? `${SITE}/hakkinda` : `${SITE}/en/about`,
  image: `${SITE}/images/artist.jpg`,
  nationality: { '@type': 'Country', name: 'Türkiye' },
  alumniOf: {
    '@type': 'CollegeOrUniversity',
    name: dil === 'tr' ? 'Bilkent Üniversitesi' : 'Bilkent University',
  },
  sameAs: ['https://www.instagram.com/ilknurgurcan_art'],
};

const sema = {
  '@context': 'https://schema.org',
  '@type': ['ArtGallery', 'EducationalOrganization'],
  '@id': `${SITE}/#atolye`,
  name: dil === 'tr' ? 'Sardunya Resim Atölyesi' : 'Sardunya Painting Studio',
  description: dil === 'tr'
    ? 'Ressam İlknur Gürcan’ın Ankara Çayyolu’ndaki atölyesi. Özgün yağlıboya eserlerin sergilendiği ve satıldığı bir galeri, aynı zamanda resim kursu verilen bir atölye.'
    : 'The Ankara studio of painter İlknur Gürcan. A gallery where original oil paintings are shown and sold, and a studio where painting courses are held.',
  url: dil === 'tr' ? `${SITE}/iletisim` : `${SITE}/en/contact`,
  image: `${SITE}/og-image.jpg`,
  telephone: '+905337136968',
  email: 'ilknurgurcan06@gmail.com',
  foundingDate: '2011',
  founder: sanatci,
  // Adresin ayrıntıları Google İşletme kaydından doğrulandı
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'MESA Koru Sitesi, Koru Çarşısı 2/A, Çayyolu',
    addressLocality: 'Çankaya',
    addressRegion: 'Ankara',
    postalCode: '06530',
    addressCountry: 'TR',
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: ENLEM,
    longitude: BOYLAM,
  },
  hasMap: haritaLinki,
  areaServed: { '@type': 'Country', name: 'Türkiye' },
  sameAs: [
    'https://www.instagram.com/ilknurgurcan_art',
    haritaLinki,          // Google İşletme kaydı
  ],
  openingHoursSpecification: [
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'],
      opens: '10:00',
      closes: '17:00',
    },
    {
      // Kapalı günü açıkça bildirmek, "saat bilgisi yok" görünmesini önler
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: 'Sunday',
      opens: '00:00',
      closes: '00:00',
    },
  ],
};
---

<script type="application/ld+json" set:html={JSON.stringify(sema)} is:inline />
