---
const base = import.meta.env.BASE_URL;
---

<footer class="bg-ink text-cream/70 mt-24">
  <div class="max-w-7xl mx-auto px-6 py-16">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-12">

      <!-- Brand -->
      <div>
        <p class="font-serif text-2xl text-cream mb-3">İlknur Gürcan</p>
        <p class="text-sm font-light leading-relaxed">
          Sardunya Atölyesi<br/>
          Özgün yağlıboya eserler
        </p>
      </div>

      <!-- Links -->
      <div>
        <p class="text-xs tracking-widest uppercase text-gold mb-4">Sayfalar</p>
        <ul class="flex flex-col gap-2 text-sm">
          <li><a href={base + 'eserler'} class="hover:text-cream transition-colors">Eserler</a></li>
          <li><a href={base + 'sergiler'} class="hover:text-cream transition-colors">Sergiler</a></li>
          <li><a href={base + 'hakkinda'} class="hover:text-cream transition-colors">Hakkında</a></li>
          <li><a href={base + 'iletisim'} class="hover:text-cream transition-colors">İletişim</a></li>
        </ul>
      </div>

      <!-- Contact -->
      <div>
        <p class="text-xs tracking-widest uppercase text-gold mb-4">İletişim</p>
        <ul class="flex flex-col gap-3 text-sm">
          <li>
            <a href="mailto:ilknurgurcan06@gmail.com" class="hover:text-cream transition-colors">
              ilknurgurcan06@gmail.com
            </a>
          </li>
          <li>
            <a href="https://instagram.com/ilknurgurcan" target="_blank" rel="noopener" class="hover:text-cream transition-colors">
              Instagram
            </a>
          </li>
          <li>
            <a href="https://wa.me/905337136968" target="_blank" rel="noopener" class="hover:text-cream transition-colors">
              WhatsApp
            </a>
          </li>
        </ul>
      </div>

    </div>

    <div class="mt-12 pt-8 border-t border-cream/10 flex flex-col md:flex-row justify-between items-center gap-4 text-xs text-cream/40">
      <p>© {new Date().getFullYear()} İlknur Gürcan. Tüm hakları saklıdır.</p>
      <p>Sardunya Atölyesi</p>
    </div>
  </div>
</footer>
