---
import Layout from '../layouts/Layout.astro';
import { devamEdenSergiler, yaklasanSergiler, gecmisSergiler } from '../data/sergiler';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout
  title="Sergiler — İlknur Gürcan"
  description="İlknur Gürcan'ın yaklaşan ve geçmiş sergileri, katıldığı fuar, festival ve çalıştaylar."
>

  <!-- Başlık -->
  <section class="max-w-7xl mx-auto px-6 pt-16 pb-10">
    <p class="text-gold-koyu text-xs tracking-[0.3em] uppercase mb-3">Takvim</p>
    <h1 class="font-serif text-5xl md:text-6xl text-ink font-light">Sergiler</h1>
  </section>

  <!-- Devam eden sergiler. Durum tarihten hesaplanıyor (sergiler-uret.py),
       Excel'de elle güncelleme gerekmiyor. -->
  {devamEdenSergiler.length > 0 && (
    <section class="max-w-7xl mx-auto px-6 pb-20">
      <h2 class="font-serif text-2xl text-ink font-light mb-8 border-b border-warm/20 pb-4">Devam Eden Sergiler</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {devamEdenSergiler.map(s => (
          <div class="border border-gold/50 p-8 bg-soft/60">
            <div class="flex items-start justify-between gap-4 mb-6">
              <span class="text-xs tracking-widest uppercase text-cream bg-gold-koyu px-3 py-1">Devam ediyor</span>
              <span class="text-xs text-muted">{s.donem}</span>
            </div>
            <h3 class="font-serif text-2xl text-ink font-light mb-2">{s.baslik}</h3>
            <p class="text-muted text-sm mb-1">{s.mekan}{s.sehir ? ` · ${s.sehir}` : ''}</p>
            <p class="text-warm text-sm mt-3">{s.tarih}</p>
          </div>
        ))}
      </div>
    </section>
  )}

  <!-- Yaklaşan sergiler -->
  {yaklasanSergiler.length > 0 && (
    <section class="max-w-7xl mx-auto px-6 pb-20">
      <h2 class="font-serif text-2xl text-ink font-light mb-8 border-b border-warm/20 pb-4">Yaklaşan Sergiler</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {yaklasanSergiler.map(s => (
          <div class="border border-warm/20 p-8 hover:border-warm/50 transition-colors">
            <div class="flex items-start justify-between gap-4 mb-6">
              <span class="text-xs tracking-widest uppercase text-gold-koyu border border-gold/40 px-3 py-1">{s.tur} Sergi</span>
              <span class="text-xs text-muted">{s.donem}</span>
            </div>
            <h3 class="font-serif text-2xl text-ink font-light mb-2">{s.baslik}</h3>
            <p class="text-muted text-sm mb-1">{s.mekan}{s.sehir ? ` · ${s.sehir}` : ''}</p>
            <p class="text-warm text-sm mt-3">{s.tarih}</p>
          </div>
        ))}
      </div>
    </section>
  )}

  <!-- Geçmiş sergiler -->
  <section class="bg-soft py-20">
    <div class="max-w-7xl mx-auto px-6">
      <h2 class="font-serif text-2xl text-ink font-light mb-3 border-b border-warm/20 pb-4">Geçmiş Sergiler</h2>

      <p class="text-muted text-sm leading-relaxed mb-8 max-w-2xl">
        Aşağıda kişisel sergilerim ile katıldığım fuar, festival ve çalıştaylar yer alıyor.
        Bunların yanı sıra 2008'den bu yana çok sayıda karma sergiye katıldım.
      </p>

      <div class="space-y-0">
        {gecmisSergiler.map((s, i) => (
          <div class={`flex items-start gap-6 py-5 ${i < gecmisSergiler.length - 1 ? 'border-b border-warm/10' : ''}`}>
            <span class="font-serif text-gold-koyu text-sm w-16 shrink-0 pt-0.5">{s.yil}</span>
            <div class="flex-1 min-w-0">
              <p class="text-ink text-sm leading-snug">{s.baslik}</p>
              {s.mekan && <p class="text-muted text-xs mt-0.5">{s.mekan}</p>}
              {s.not && <p class="text-gold-koyu text-xs mt-0.5">{s.not}</p>}
            </div>
            <div class="flex items-center gap-3 shrink-0">
              <span class="text-muted text-xs hidden sm:inline">{s.sehir}</span>
              <span class={`text-xs px-2 py-0.5 border whitespace-nowrap ${
                s.tur === 'Kişisel' ? 'text-gold-koyu border-gold/30' : 'text-muted border-warm/20'
              }`}>{s.tur}</span>
            </div>
          </div>
        ))}
      </div>

    </div>
  </section>

  <!-- CTA -->
  <section class="max-w-7xl mx-auto px-6 py-16 text-center">
    <p class="text-muted leading-relaxed mb-6">
      Yaklaşan sergilere katılmak veya özel bir eser için bilgi almak ister misiniz?
    </p>
    <a
      href={base + '/iletisim'}
      class="inline-flex items-center justify-center px-8 py-3 bg-ink text-cream text-sm tracking-widest uppercase hover:bg-ink/90 transition-colors"
    >
      İletişime Geç
    </a>
  </section>

</Layout>
