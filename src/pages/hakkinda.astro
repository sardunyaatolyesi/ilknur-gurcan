---
import Layout from '../layouts/Layout.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout
  title="Hakkında — İlknur Gürcan"
  description="İlknur Gürcan'ın sanat yolculuğu, eğitimi ve Sardunya Atölyesi hakkında bilgi edinin."
  image="/images/artist.jpg"
>

  <!-- Başlık -->
  <section class="max-w-7xl mx-auto px-6 pt-16 pb-10">
    <p class="text-gold text-xs tracking-[0.3em] uppercase mb-3">Sanatçı</p>
    <h1 class="font-serif text-5xl md:text-6xl text-ink font-light">İlknur Gürcan</h1>
  </section>

  <!-- Ana içerik: fotoğraf + biyografi -->
  <section class="max-w-7xl mx-auto px-6 pb-24">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-16 items-start">

      <!-- Sol: Fotoğraf -->
      <div class="relative">
        <div class="aspect-[3/4] bg-warm/20 overflow-hidden">
          <img
            src={base + '/images/artist.jpg'}
            alt="İlknur Gürcan"
            class="w-full h-full object-cover"
            loading="eager"
          />
        </div>
        <div class="absolute -bottom-4 -right-4 w-full h-full border border-warm/30 -z-10"></div>
      </div>

      <!-- Sağ: Biyografi -->
      <div class="space-y-10">

        <!-- Giriş -->
        <div>
          <p class="text-gold text-xs tracking-[0.3em] uppercase mb-4">Mühendislikten Sanata</p>
          <div class="space-y-4 text-muted leading-relaxed">
            <p>
              1972 yılında Isparta'da doğan İlknur Gürcan, Ankara Fen Lisesi'ni ve
              Bilkent Üniversitesi Endüstri Mühendisliği Bölümü'nü tamamladıktan sonra
              ASELSAN ve TÜBİTAK ULAKBİM'de uzun yıllar mühendis olarak çalıştı.
            </p>
            <p>
              Çocukluğundan bu yana kendi çabalarıyla sürdürdüğü resim tutkusu, zamanla
              Mehmet Yılmaz, Nusret Dökmeci ve Oktay Bingöl gibi değerli sanatçıların
              rehberliğinde şekillendi.
            </p>
            <p>
              2011 yılında kurduğu <em>Sardunya Resim Atölyesi</em>, hem kendi üretimine
              ev sahipliği yapan hem de öğrencilerini ağırlayan bir yaratım alanına dönüştü.
            </p>
          </div>
        </div>

        <!-- Sanat anlayışı -->
        <div class="border-t border-warm/20 pt-8">
          <p class="text-gold text-xs tracking-[0.3em] uppercase mb-4">Sanat Anlayışı</p>
          <div class="space-y-4 text-muted leading-relaxed">
            <p>
              Günümüz şehir insanının günlük sosyal yaşamını konu alan İlknur Gürcan'ın
              tabloları; kafeler, sokaklar ve insan figürü üzerine yoğunlaşır.
            </p>
            <p>
              Geçici ışığı, o anın duygusunu ve sokağın sessiz şiirini tuvale aktarmak,
              her eserinin temel güdüsüdür.
            </p>
          </div>
        </div>

        <!-- Kısa bilgiler -->
        <div class="border-t border-warm/20 pt-8 grid grid-cols-1 sm:grid-cols-2 gap-6">
          <div>
            <p class="text-xs text-muted tracking-widest uppercase mb-2">Eğitim</p>
            <p class="text-sm text-ink">Ankara Fen Lisesi</p>
            <p class="text-sm text-ink">Bilkent Üni. — Endüstri Müh.</p>
          </div>
          <div>
            <p class="text-xs text-muted tracking-widest uppercase mb-2">Atölye</p>
            <p class="text-sm text-ink">Sardunya Resim Atölyesi</p>
            <p class="text-sm text-muted">Ankara · 2011'den beri</p>
          </div>
          <div>
            <p class="text-xs text-muted tracking-widest uppercase mb-2">Teknik</p>
            <p class="text-sm text-ink">Yağlıboya, tuval üzerine</p>
          </div>
          <div>
            <p class="text-xs text-muted tracking-widest uppercase mb-2">Sergiler</p>
            <p class="text-sm text-ink">8 kişisel · çok sayıda karma</p>
          </div>
        </div>

        <!-- CTA -->
        <div class="border-t border-warm/20 pt-8 flex flex-col sm:flex-row gap-4">
          <a
            href={base + '/eserler'}
            class="inline-flex items-center justify-center px-8 py-3 bg-ink text-cream text-sm tracking-widest uppercase hover:bg-ink/90 transition-colors"
          >
            Eserleri Keşfet
          </a>
          <a
            href={base + '/iletisim'}
            class="inline-flex items-center justify-center px-8 py-3 border border-warm/40 text-warm text-sm tracking-widest uppercase hover:border-warm hover:text-ink transition-colors"
          >
            İletişime Geç
          </a>
        </div>

      </div>
    </div>
  </section>

  <!-- Hocalar -->
  <section class="bg-soft py-20">
    <div class="max-w-7xl mx-auto px-6">
      <p class="text-gold text-xs tracking-[0.3em] uppercase mb-3">Eğitim Aldığı Sanatçılar</p>
      <h2 class="font-serif text-3xl text-ink font-light mb-10">Yol Gösterenler</h2>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-8">
        {[
          { ad: 'Mehmet Yılmaz' },
          { ad: 'Nusret Dökmeci' },
          { ad: 'Oktay Bingöl' },
        ].map(({ ad }) => (
          <div class="border-l-2 border-gold/50 pl-5">
            <p class="font-serif text-xl text-ink font-light">{ad}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Sergiler linki -->
  <section class="max-w-7xl mx-auto px-6 py-16 text-center">
    <p class="text-muted leading-relaxed mb-6">
      2008'den bu yana çok sayıda karma sergiye katılan İlknur Gürcan'ın sekiz kişisel sergisi bulunmaktadır.
    </p>
    <a
      href={base + '/sergiler'}
      class="inline-flex items-center gap-2 text-sm tracking-widest uppercase text-warm hover:text-ink transition-colors border-b border-warm/50 hover:border-ink pb-1"
    >
      Tüm Sergileri Gör
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
      </svg>
    </a>
  </section>

</Layout>
