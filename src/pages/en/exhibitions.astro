---
import Layout from '../../layouts/Layout.astro';
import { yaklasanSergiler, gecmisSergiler } from '../../data/sergiler';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout
  title="Exhibitions — İlknur Gürcan"
  description="Upcoming and past exhibitions of painter İlknur Gürcan, with the art fairs, festivals and workshops she has taken part in."
>

  <section class="max-w-7xl mx-auto px-6 pt-16 pb-10">
    <p class="text-gold text-xs tracking-[0.3em] uppercase mb-3">Calendar</p>
    <h1 class="font-serif text-5xl md:text-6xl text-ink font-light">Exhibitions</h1>
  </section>

  <!-- Upcoming -->
  {yaklasanSergiler.length > 0 && (
    <section class="max-w-7xl mx-auto px-6 pb-20">
      <h2 class="font-serif text-2xl text-ink font-light mb-8 border-b border-warm/20 pb-4">Upcoming</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {yaklasanSergiler.map(s => (
          <div class="border border-warm/20 p-8 hover:border-warm/50 transition-colors">
            <div class="flex items-start justify-between gap-4 mb-6">
              <span class="text-xs tracking-widest uppercase text-gold border border-gold/40 px-3 py-1">{s.tur_en}</span>
              <span class="text-xs text-muted">{s.donem_en}</span>
            </div>
            <h3 class="font-serif text-2xl text-ink font-light mb-2">{s.baslik_en}</h3>
            <p class="text-muted text-sm mb-1">{s.mekan_en}{s.sehir ? ` · ${s.sehir}` : ''}</p>
            <p class="text-warm text-sm mt-3">{s.tarih_en}</p>
          </div>
        ))}
      </div>
    </section>
  )}

  <!-- Past -->
  <section class="bg-soft py-20">
    <div class="max-w-7xl mx-auto px-6">
      <h2 class="font-serif text-2xl text-ink font-light mb-3 border-b border-warm/20 pb-4">Past Exhibitions</h2>

      <p class="text-muted text-sm leading-relaxed mb-8 max-w-2xl">
        Listed below are my solo exhibitions together with the art fairs, festivals and
        workshops I have taken part in. Alongside these, I have taken part in numerous
        group exhibitions since 2008.
      </p>

      <div class="space-y-0">
        {gecmisSergiler.map((s, i) => (
          <div class={`flex items-start gap-6 py-5 ${i < gecmisSergiler.length - 1 ? 'border-b border-warm/10' : ''}`}>
            <span class="font-serif text-gold text-sm w-16 shrink-0 pt-0.5">{s.yil}</span>
            <div class="flex-1 min-w-0">
              <p class="text-ink text-sm leading-snug">{s.baslik_en}</p>
              {s.mekan_en && <p class="text-muted text-xs mt-0.5">{s.mekan_en}</p>}
              {s.not_en && <p class="text-gold text-xs mt-0.5">{s.not_en}</p>}
            </div>
            <div class="flex items-center gap-3 shrink-0">
              <span class="text-muted text-xs hidden sm:inline">{s.sehir}</span>
              <span class={`text-xs px-2 py-0.5 border whitespace-nowrap ${
                s.tur === 'Kişisel' ? 'text-gold border-gold/30' : 'text-muted border-warm/20'
              }`}>{s.tur_en}</span>
            </div>
          </div>
        ))}
      </div>

    </div>
  </section>

  <section class="max-w-7xl mx-auto px-6 py-16 text-center">
    <p class="text-muted leading-relaxed mb-6">
      Would you like to hear about upcoming exhibitions, or ask about a particular painting?
    </p>
    <a
      href={base + '/en/contact'}
      class="inline-flex items-center justify-center px-8 py-3 bg-ink text-cream text-sm tracking-widest uppercase hover:bg-ink/90 transition-colors"
    >
      Get in Touch
    </a>
  </section>

</Layout>
