---
import Layout from '../layouts/Layout.astro';

const whatsappMesaj = encodeURIComponent('Merhaba, bir eser hakkında bilgi almak istiyorum.');

// Web3Forms erişim anahtarı — web3forms.com'dan e-postayla gelir.
// Değiştirmek için sadece bu satırı güncelleyin.
const WEB3FORMS_ANAHTARI = '4637d97f-b1ac-49c5-ad13-b6c01d27909d';
---

<Layout
  title="İletişim — İlknur Gürcan"
  description="İlknur Gürcan ile iletişime geçin. Eser satın alma, sergi ve atölye bilgisi için."
>

  <!-- Başlık -->
  <section class="max-w-7xl mx-auto px-6 pt-16 pb-10">
    <p class="text-gold text-xs tracking-[0.3em] uppercase mb-3">Bize Ulaşın</p>
    <h1 class="font-serif text-5xl md:text-6xl text-ink font-light">İletişim</h1>
  </section>

  <section class="max-w-7xl mx-auto px-6 pb-24">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16">

      <!-- Sol: İletişim kanalları -->
      <div class="space-y-6">
        <p class="text-muted leading-relaxed">
          Eserler, satın alma, sergi bilgisi veya atölye hakkında her türlü sorunuz için
          aşağıdaki kanallardan ulaşabilirsiniz.
        </p>

        <!-- WhatsApp -->
        <div class="border border-warm/20 p-6 hover:border-warm/50 transition-colors">
          <p class="text-xs text-muted tracking-widest uppercase mb-2">WhatsApp</p>
          <p class="font-serif text-2xl text-ink font-light mb-4">+90 533 713 69 68</p>
          <a
            href={`https://wa.me/905337136968?text=${whatsappMesaj}`}
            target="_blank"
            rel="noopener"
            class="inline-flex items-center gap-2 px-6 py-3 bg-ink text-cream text-xs tracking-widest uppercase hover:bg-ink/90 transition-colors"
          >
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
            </svg>
            Mesaj Gönder
          </a>
        </div>

        <!-- E-posta -->
        <div class="border border-warm/20 p-6 hover:border-warm/50 transition-colors">
          <p class="text-xs text-muted tracking-widest uppercase mb-2">E-posta</p>
          <p class="font-serif text-2xl text-ink font-light mb-4">ilknurgurcan06@gmail.com</p>
          <a
            href="mailto:ilknurgurcan06@gmail.com"
            class="inline-flex items-center gap-2 px-6 py-3 border border-warm/40 text-warm text-xs tracking-widest uppercase hover:border-warm hover:text-ink transition-colors"
          >
            E-posta Gönder
          </a>
        </div>

        <!-- Atölye -->
        <div class="border border-warm/20 p-6">
          <p class="text-xs text-muted tracking-widest uppercase mb-2">Atölye</p>
          <p class="font-serif text-xl text-ink font-light">Sardunya Resim Atölyesi</p>
          <p class="text-muted text-sm mt-2 leading-relaxed">
            MESA Koru Sitesi, Koru Çarşısı 2/A<br/>
            Çayyolu — Ankara
          </p>
        </div>
      </div>

      <!-- Sağ: Form -->
      <div>
        <p class="text-xs text-muted tracking-widest uppercase mb-6">Mesaj Gönderin</p>

        <form
          action="https://api.web3forms.com/submit"
          method="POST"
          class="space-y-5"
          id="iletisim-form"
        >
          <input type="hidden" name="access_key" value={WEB3FORMS_ANAHTARI} />

          <!-- Gelen kutusunda gönderen adı: mesajın siteden geldiği belli olsun -->
          <input type="hidden" name="from_name" value="ilknurgurcan.com web sitesi" />

          <!-- Bot tuzağı: görünmez, insanlar doldurmaz, botlar doldurur -->
          <input
            type="checkbox"
            name="botcheck"
            tabindex="-1"
            autocomplete="off"
            aria-hidden="true"
            style="display:none"
          />

          <div>
            <label for="isim" class="block text-xs text-muted tracking-widest uppercase mb-2">Adınız</label>
            <input
              type="text"
              id="isim"
              name="name"
              required
              placeholder="Ad Soyad"
              class="w-full bg-transparent border border-warm/30 px-4 py-3 text-sm text-ink placeholder:text-muted/50 focus:outline-none focus:border-warm transition-colors"
            />
          </div>

          <div>
            <label for="email" class="block text-xs text-muted tracking-widest uppercase mb-2">E-posta</label>
            <input
              type="email"
              id="email"
              name="email"
              required
              placeholder="ornek@email.com"
              class="w-full bg-transparent border border-warm/30 px-4 py-3 text-sm text-ink placeholder:text-muted/50 focus:outline-none focus:border-warm transition-colors"
            />
          </div>

          <div>
            <label for="konu" class="block text-xs text-muted tracking-widest uppercase mb-2">Konu</label>
            <select
              id="konu"
              name="Konu"
              class="w-full bg-cream border border-warm/30 px-4 py-3 text-sm text-ink focus:outline-none focus:border-warm transition-colors"
            >
              <option>Eser Hakkında Bilgi</option>
              <option>Satın Alma</option>
              <option>Sergi Bilgisi</option>
              <option>Diğer</option>
            </select>
          </div>

          <div>
            <label for="mesaj" class="block text-xs text-muted tracking-widest uppercase mb-2">Mesajınız</label>
            <textarea
              id="mesaj"
              name="Mesaj"
              required
              rows="6"
              placeholder="Mesajınızı buraya yazın..."
              class="w-full bg-transparent border border-warm/30 px-4 py-3 text-sm text-ink placeholder:text-muted/50 focus:outline-none focus:border-warm transition-colors resize-none"
            ></textarea>
          </div>

          <button
            type="submit"
            id="form-gonder"
            class="w-full py-3 bg-ink text-cream text-sm tracking-widest uppercase hover:bg-ink/90 transition-colors disabled:opacity-50 disabled:cursor-not-allowed"
          >
            Gönder
          </button>

          <!-- Gönderim durumu -->
          <p id="form-basari" class="hidden text-center text-sm text-warm py-2">
            Mesajınız iletildi. En kısa sürede dönüş yapacağım.
          </p>
          <p id="form-hata" class="hidden text-center text-sm text-muted py-2">
            Bir hata oluştu. Lütfen e-posta veya WhatsApp ile iletişime geçin.
          </p>
        </form>
      </div>

    </div>
  </section>

</Layout>

<script>
  const form   = document.getElementById('iletisim-form') as HTMLFormElement | null;
  const buton  = document.getElementById('form-gonder') as HTMLButtonElement | null;
  const basari = document.getElementById('form-basari');
  const hata   = document.getElementById('form-hata');

  function durumGoster(el: HTMLElement | null) {
    basari?.classList.add('hidden');   // önce ikisini de gizle ki
    hata?.classList.add('hidden');     // eski mesaj ekranda kalmasın
    el?.classList.remove('hidden');
  }

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!buton) return;

    durumGoster(null);
    buton.disabled = true;
    buton.textContent = 'Gönderiliyor…';

    const data = new FormData(form);
    // E-postanın konu satırı, seçilen konuya göre anlamlı olsun
    data.append('subject', `Sardunya Atölyesi — ${data.get('Konu') ?? 'Yeni mesaj'}`);

    try {
      const res = await fetch(form.action, {
        method: 'POST',
        body: data,
        headers: { Accept: 'application/json' },
      });
      if (res.ok) {
        form.reset();
        durumGoster(basari);
      } else {
        durumGoster(hata);
      }
    } catch {
      durumGoster(hata);
    } finally {
      buton.disabled = false;
      buton.textContent = 'Gönder';
    }
  });
</script>
