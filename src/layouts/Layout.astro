---
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { dilBul, digerDilYolu } from '../i18n/ui';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const dil = dilBul(Astro.url.pathname);

const varsayilan = {
  tr: {
    title: 'İlknur Gürcan — Sanatçı',
    description: "İlknur Gürcan'ın özgün yağlıboya eserlerini keşfedin. Kafeler, sokaklar ve figür serilerinden seçilmiş tablolar.",
  },
  en: {
    title: 'İlknur Gürcan — Painter',
    description: 'Original oil paintings by İlknur Gürcan. Cafés, streets and figures from everyday life.',
  },
}[dil];

const {
  title = varsayilan.title,
  description = varsayilan.description,
  image = '/og-image.jpg',
} = Astro.props;

const site = Astro.site?.origin ?? 'https://ilknurgurcan.com';
const buSayfa  = Astro.url.pathname;
const trYolu   = digerDilYolu(buSayfa, 'tr');
const enYolu   = digerDilYolu(buSayfa, 'en');

// Sosyal ağlar og:image için mutlak URL ister; göreli yol verilirse
// paylaşımda hiç görsel çıkmaz.
const gorselUrl = image.startsWith('http') ? image : site + image;
const sayfaUrl  = site + buSayfa;
---

<!DOCTYPE html>
<html lang={dil}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={gorselUrl} />
  <meta property="og:url" content={sayfaUrl} />
  <meta property="og:site_name" content="İlknur Gürcan" />
  <meta property="og:type" content="website" />
  <meta property="og:locale" content={dil === 'tr' ? 'tr_TR' : 'en_US'} />
  <meta property="og:locale:alternate" content={dil === 'tr' ? 'en_US' : 'tr_TR'} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={gorselUrl} />

  <!-- Arama motorlarına sayfanın diğer dildeki karşılığını bildir -->
  <link rel="canonical" href={site + buSayfa} />
  <link rel="alternate" hreflang="tr" href={site + trYolu} />
  <link rel="alternate" hreflang="en" href={site + enYolu} />
  <link rel="alternate" hreflang="x-default" href={site + trYolu} />

  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
</head>
<body class="min-h-screen flex flex-col">
  <Nav />
  <main class="flex-1 pt-16">
    <slot />
  </main>
  <Footer />
</body>
</html>
